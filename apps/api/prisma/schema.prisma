generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  PLATFORM_ADMIN
  SUPPLIER
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum OrderStatus {
  PENDING
  APPROVED
  FULFILLED
  REJECTED
  CANCELLED
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  location  String?
  // Depo sekmelerinin gösterim sırası (admin tarafından sürükle-bırak ile ayarlanır).
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Depo bir Admin'e aittir; o Admin depoyu diğer depolarından bağımsız, sınırsız
  // sayıda oluşturabilir/yeniden adlandırabilir. Admin'in altındaki Kullanıcılar da
  // (adminOwnerId üzerinden), WarehouseAccess ile kısıtlanmadıkları sürece, bu depo
  // havuzunun tamamını görür.
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Sınırsız derinlikte hiyerarşi: NULL ise bu depo bir "Ana Depo" (kök). Bir depo
  // silinirse altındaki tüm alt ağaç da silinir (Cascade).
  parentId String?
  parent   Warehouse?  @relation("WarehouseTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Warehouse[] @relation("WarehouseTree")

  // Bu deponun, bir üst bağlamın birleşik ("Bütün Ürünler"/allChildrenLabel) toplamına
  // dahil mi yoksa bağımsız mı sayılacağı. Alt depoda üst deponun toplamı için geçerlidir;
  // Ana Depo'da (parentId null) sahibin kök seviye "Bütün Ürünler" toplamı için geçerlidir.
  includeInParentTotal Boolean @default(true)

  // Bu depo çocuklara sahipse, kendi alt depolarının birleşik ("Bütün Ürünler")
  // sekmesinin gösterim adı — admin tarafından yeniden adlandırılabilir.
  allChildrenLabel String @default("Bütün Ürünler")

  products     Product[]
  accessGrants WarehouseAccess[]

  // İsim tekilliği application seviyesinde (ownerId + parentId + name) kontrol edilir
  // — SQLite'ta NULL parentId'ler unique index'te birbirinden ayrı sayıldığından kök
  // depolar için DB constraint'e güvenilemez, bkz. warehouses.service.ts.
  @@index([ownerId, parentId])
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Sadece role=USER için anlamlıdır: hangi Admin'in depo havuzuna erişir.
  adminOwnerId String?
  adminOwner   User?   @relation("AdminOwnsUsers", fields: [adminOwnerId], references: [id])
  managedUsers User[]  @relation("AdminOwnsUsers")

  // Sadece role=ADMIN için anlamlıdır: kök seviye "Bütün Ürünler" sekmesinin bu Admin
  // için özelleştirilmiş adı. NULL ise varsayılan "Bütün Ürünler" kullanılır.
  rootAllWarehousesLabel String?

  ownedWarehouses Warehouse[]
  categories      Category[]
  stockMovements  StockMovement[]
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]
  ordersRequested Order[]         @relation("OrderRequestedBy")
  ordersDecided   Order[]         @relation("OrderDecidedBy")
  ordersSupplied  Order[]         @relation("OrderSuppliedBy")
  // Sadece role=USER için anlamlıdır: hangi depolarda çalışabileceğine dair açık
  // izinler. Boşsa (hiç kayıt yoksa) adminOwner'ın tüm depo havuzuna erişir.
  warehouseAccess WarehouseAccess[]
}

/** Bir USER'ın çalışabileceği depo(lar) — verildiğinde erişim SADECE bunlarla (+ alt ağaçlarıyla) sınırlanır. */
model WarehouseAccess {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, warehouseId])
  @@index([warehouseId])
}

model RefreshToken {
  // JWT'nin jti claim'i ile aynı değer — refresh JWT'yi tek tek geçersiz kılabilmek için.
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Category {
  id       String    @id @default(uuid())
  name     String
  products Product[]

  // Kategoriler Admin'e özeldir — bir Admin'in kategori isimleri başka Admin'lere
  // sızmamalı/karışmamalı (bkz. categories.service.ts findAll/update/remove).
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, name])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  unit        String   @default("adet")
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  imageUrl String? // sadece admin panelinden yüklenir

  // Ürünlerin listede/kartlarda gösterim sırası (admin sürükle-bırak ile ayarlar).
  sortOrder Int @default(0)

  currentStock Int @default(0) // ledger'dan türetilip cache'lenir

  leadTimeDays     Int @default(5)
  safetyMarginDays Int @default(3)

  criticalLevelManual Int?    // yeni ürünlerde veya admin override'ında kullanılır
  criticalLevel        Int    @default(0) // efektif kritik seviye (öneri veya manuel)
  suggestedCriticalLevel Int? // sistem tarafından hesaplanan öneri
  avgDailyConsumption7d  Float @default(0)
  avgDailyConsumption30d Float @default(0)
  confidence   String  @default("LOW") // LOW | MEDIUM | HIGH

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]
  orders    Order[]

  @@unique([warehouseId, name])
  @@index([warehouseId, sortOrder])
}

model StockMovement {
  id        String       @id @default(uuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      MovementType
  quantity  Int
  reason    String?
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@index([productId, createdAt])
}

/** Bir kullanıcının bir ürün için verdiği talep — Admin onaylayana/reddedene kadar PENDING'de bekler. */
model Order {
  id        String      @id @default(uuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  note      String?
  status    OrderStatus @default(PENDING)

  requestedById String
  requestedBy   User   @relation("OrderRequestedBy", fields: [requestedById], references: [id])

  // Admin kararı (approve/reject) — yalnızca PENDING'den çıkarken doldurulur.
  decidedById  String?
  decidedBy    User?     @relation("OrderDecidedBy", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?

  // Tedarikçinin fiili tedarik onayı — yalnızca APPROVED'dan FULFILLED'a geçerken doldurulur.
  suppliedById String?
  suppliedBy   User?     @relation("OrderSuppliedBy", fields: [suppliedById], references: [id])
  suppliedAt   DateTime?
  supplyNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, createdAt])
  @@index([requestedById, createdAt])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  meta       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([resource, resourceId])
}
